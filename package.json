{
  "name": "ai-support-engine",
  "version": "1.0.0",
  "description": "Clasificador inteligente de solicitudes de soporte: motor tradicional (reglas) y generativo (LLM)",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "eval": "node --env-file-if-exists=.env eval/run-eval.js",
    "eval:traditional": "node eval/run-eval.js --engines traditional"
  }
}
