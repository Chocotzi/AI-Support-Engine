# Copie este archivo a .env (NO suba .env a git).

# Proveedor: gemini | ollama (local) | anthropic | openai
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# Ollama local (https://ollama.com):  ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434

# Solo si usa API en la nube:
# Gemini: llave en https://aistudio.google.com/apikey  (modelo por defecto: gemini-3.8-flash)
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # cualquier API compatible con OpenAI

LLM_TIMEOUT_MS=30000
PORT=3000
